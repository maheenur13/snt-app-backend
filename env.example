PORT=4000
# local: mongodb://127.0.0.1:27017/secure-notes
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure-notes?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/secure-notes
# at least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
CLIENT_URL=http://localhost:5173
# proxies in front of the app: 0 locally, 2 on Render behind the Vercel /api proxy
TRUST_PROXY=0
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# optional: an admin that is (re)created on every startup so reviewers can log in. Set both or neither.
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=DemoAdmin@2026
